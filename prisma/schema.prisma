generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Session {
  id        String   @id @default(uuid())
  userId    String?
  createdAt DateTime @default(now())
}

model TelemetryLog {
  id           String   @id @default(uuid())
  toolName     String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())
  sessionId    String?
}
